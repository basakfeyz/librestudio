                  <tr><td><code>_ga</code></td><td>Google Analytics (.librestudio.co)</td><td>Analytics: distinguishing visitors</td><td>2 years</td></tr>
                  <tr><td><code>_ga_&lt;ID&gt;</code></td><td>Google Analytics (.librestudio.co)</td><td>Analytics: keeping the session state</td><td>2 years</td></tr>
